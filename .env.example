# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored. Never commit real keys.

# --- Google Cloud / BigQuery ---
GCP_PROJECT=your-gcp-project-id
BQ_DATASET=artist_pipeline
# Full path to the service account JSON key, stored OUTSIDE the repo.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\you\Desktop\prjcts\secrets\gcp-key.json

# --- API keys ---
YOUTUBE_API_KEY=your-youtube-data-api-key
TICKETMASTER_API_KEY=your-ticketmaster-discovery-key
SETLIST_FM_API_KEY=your-setlist-fm-api-key

# --- Polite client identification (no personal email) ---
# Sent as the User-Agent header to MusicBrainz, which requires one.
MUSICBRAINZ_USER_AGENT=Stanner/0.1 (https://github.com/LincolnNeilsen/Stanner)
